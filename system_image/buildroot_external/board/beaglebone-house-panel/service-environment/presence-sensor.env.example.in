# @BHP_BOARD_ID@ -- rendered at image build time by post-build.sh with
# scripts/boards/render_service_environment.sh from config/boards/@BHP_BOARD_ID@.env.
# REPLACE_ME_UNMEASURED_<gate> means that board fact still needs on-board evidence
# (docs/operations/frdm-bringup.md); the service refuses to start with it.
# Copy to presence-sensor.env, keep owned by root, and use mode 0640.
# S31bhp-presence-sensor stays inert unless this is changed to exactly 1.
BHP_PRESENCE_SENSOR_ENABLED=0

# Must be exactly custom_pir_input_driver or stock_gpio_keys_wake_baseline.
# Do not choose either until voltage, board revision, pin ownership, and
# independent recovery have been verified. Never apply both.
# Board @BHP_BOARD_ID@: stock_gpio_keys_wake_baseline checks the device-tree node
# /@BHP_BOARD_PIR_DT_NODE@ and input "@BHP_BOARD_PIR_INPUT_NAME@";
# custom_pir_input_driver checks /@BHP_BOARD_PIR_CUSTOM_DT_NODE@ and input
# "@BHP_BOARD_PIR_CUSTOM_INPUT_NAME@" (S31 reads these from the installed board
# profile, /usr/share/beaglebone-house-panel/board-profile.env).
BHP_PRESENCE_SENSOR_EXPERIMENT=UNCONFIGURED

# The package stages inert overlay artifacts (@BHP_BOARD_PRESENCE_OVERLAYS@) here.
# Applying one at boot is a separate, board-specific operation that this
# prototype intentionally omits.
BHP_PRESENCE_SENSOR_OVERLAY_DIRECTORY=/usr/lib/beaglebone-house-panel/device-tree-overlays
