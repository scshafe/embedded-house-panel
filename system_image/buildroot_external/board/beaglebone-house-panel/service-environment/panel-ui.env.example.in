# @BHP_BOARD_ID@ -- rendered at image build time by post-build.sh with
# scripts/boards/render_service_environment.sh from config/boards/@BHP_BOARD_ID@.env.
# REPLACE_ME_UNMEASURED_<gate> means that board fact still needs on-board evidence
# (docs/operations/frdm-bringup.md); the service refuses to start with it.
# Copy to panel-ui.env, keep owned by root:panel-ui, and use mode 0640.
# S75bhp-panel-ui stays inert unless this is exactly 1. Do not enable it until
# an evidence-backed physical display commit backend replaces the current
# fail-dark lifecycle backend.
BHP_PANEL_UI_ENABLED=0

# Buildroot fixes the non-login panel-ui principal at UID/GID 1102. Configure
# panel_supervisord's exact SO_PEERCRED expectation to 1102 in the same image.
# This is deployment identity, not a caller-overridable runtime setting.

# The manually invoked persistent fail-dark service requires every value below
# and has no defaults. S75 does not consume them while physical display commit
# evidence is unavailable and service enablement remains prohibited.
# BHP_PANEL_UI_SOCKET_PATH=REPLACE_ME_WITH_ABSOLUTE_SUPERVISOR_SOCKET
# BHP_PANEL_UI_SUPERVISOR_UID=REPLACE_ME_WITH_EXACT_SUPERVISOR_UID
# BHP_PANEL_UI_RECEIVE_TIMEOUT_MS=REPLACE_ME_WITH_REVIEWED_MILLISECONDS
# BHP_PANEL_UI_RECONNECT_DELAY_MS=REPLACE_ME_WITH_REVIEWED_MILLISECONDS
# BHP_PANEL_UI_MAXIMUM_CONSECUTIVE_FAILURES=REPLACE_ME_WITH_REVIEWED_BOUND
# BHP_PANEL_UI_CONFLICT_WINDOW_MS=REPLACE_ME_WITH_REVIEWED_MILLISECONDS
# BHP_PANEL_UI_CONFLICT_WINDOW_EVIDENCE_ID=REPLACE_ME_WITH_NON_PLACEHOLDER_EVIDENCE_ID
# BHP_PANEL_UI_MAXIMUM_SOURCE_INSTANCES=REPLACE_ME_WITH_REVIEWED_BOUND
# BHP_PANEL_UI_MAXIMUM_UTF8_BYTES=REPLACE_ME_WITH_REVIEWED_BOUND
# BHP_PANEL_UI_MAXIMUM_CODE_POINTS=REPLACE_ME_WITH_REVIEWED_BOUND
# BHP_PANEL_UI_ALLOW_LINE_BREAKS=REPLACE_ME_WITH_0_OR_1
# BHP_PANEL_UI_ACTIVE_SURFACE_ID=REPLACE_ME_WITH_REGISTERED_SURFACE_ID

# Display selection reserved for the physical display commit backend (the LVGL
# renderer's LvglFlashCardRendererConfiguration). Board profile, FRDM-GATE-DISPLAY
# on the FRDM. DRM is primary. The fbdev fallback is an explicit operator change
# made only after DRM evidence fails; nothing falls back automatically.
# BHP_PANEL_UI_DISPLAY_BACKEND=@BHP_BOARD_DISPLAY_BACKEND@
# BHP_PANEL_UI_DISPLAY_DRM_DEVICE=@BHP_BOARD_DRM_DEVICE@
# BHP_PANEL_UI_DISPLAY_DRM_CONNECTOR_ID=@BHP_BOARD_DRM_CONNECTOR_ID@
# BHP_PANEL_UI_DISPLAY_RESOLUTION=@BHP_BOARD_DISPLAY_RESOLUTION@
# Fallback (explicit): BHP_PANEL_UI_DISPLAY_BACKEND=@BHP_BOARD_DISPLAY_BACKEND_FALLBACK@
# BHP_PANEL_UI_DISPLAY_FBDEV_DEVICE=@BHP_BOARD_FBDEV_DEVICE@

# study.v1 client for the vocabulary surface hosted by this shell, reserved for
# the same display cutover (docs/interfaces/lexinet-contract.md). ADR 0010:
# tailnet_node authentication; the panel stores no study credential, so the
# credential path stays empty. Never put a credential value, auth key or
# Tailnet state in this file or in the image.
# BHP_VOCABULARY_PANEL_LEXINET_BASE_URL=https://lexinet-placeholder.example.ts.net
# BHP_VOCABULARY_PANEL_STUDY_PROFILE_REF=replace.with.profile
# BHP_VOCABULARY_PANEL_STUDY_TOPIC_REFS=replace-with-topic-slug
# BHP_VOCABULARY_PANEL_STUDY_AUTH_MODE=tailnet_node
# BHP_VOCABULARY_PANEL_CREDENTIAL_FILE=
# BHP_VOCABULARY_PANEL_CONNECT_TIMEOUT_MS=1000
# BHP_VOCABULARY_PANEL_REQUEST_TIMEOUT_MS=3000
# BHP_VOCABULARY_PANEL_MAXIMUM_RESPONSE_BYTES=1048576
# BHP_VOCABULARY_PANEL_MAXIMUM_SNAPSHOT_AGE_SECONDS=604800
