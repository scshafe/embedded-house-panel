# @BHP_BOARD_ID@ -- rendered at image build time by post-build.sh with
# scripts/boards/render_service_environment.sh from config/boards/@BHP_BOARD_ID@.env.
# REPLACE_ME_UNMEASURED_<gate> means that board fact still needs on-board evidence
# (docs/operations/frdm-bringup.md); the service refuses to start with it.
# Copy to panel-supervisor.env, keep owned by root, and use mode 0640.
# S70panel_supervisord stays inert unless this is changed to exactly 1.
BHP_PANEL_SUPERVISOR_ENABLED=0

# Installation coordinates. REPLACE_ME values are deliberate parse failures so
# an enabled service cannot silently use fake coordinates.
BHP_PANEL_SUPERVISOR_LATITUDE=REPLACE_ME
BHP_PANEL_SUPERVISOR_LONGITUDE=REPLACE_ME

BHP_PANEL_SUPERVISOR_PRESENCE_GRACE_SECONDS=120
# Board profile BHP_BOARD_BACKLIGHT_SYSFS_DIR (FRDM-GATE-BACKLIGHT on the FRDM).
BHP_PANEL_SUPERVISOR_BACKLIGHT_PATH=@BHP_BOARD_BACKLIGHT_SYSFS_DIR@/brightness
BHP_PANEL_SUPERVISOR_BACKLIGHT_MAX_PATH=@BHP_BOARD_BACKLIGHT_SYSFS_DIR@/max_brightness
# BusyBox mdev does not create udev-style by-path links. Prefer the verified
# exact EVIOCGNAME: the daemon rescans event nodes and requires exactly one
# matching device with SW_FRONT_PROXIMITY capability. Board profile
# BHP_BOARD_PIR_INPUT_NAME is the gpio-keys label the project DTB assigns;
# confirm it with the PIR evidence script before enabling.
BHP_PANEL_SUPERVISOR_PRESENCE_INPUT_NAME=@BHP_BOARD_PIR_INPUT_NAME@
# Alternative for a deliberately stable node: remove NAME and set exactly one PATH.
# BHP_PANEL_SUPERVISOR_PRESENCE_INPUT_PATH=/dev/input/eventREPLACE_ME
BHP_PANEL_SUPERVISOR_MODE_SOCKET=/run/beaglebone-house-panel/panel-mode.sock
BHP_PANEL_SUPERVISOR_PANEL_UI_UID=1102
BHP_PANEL_SUPERVISOR_PRESENTATION_TIMEOUT_MILLISECONDS=REPLACE_ME_WITH_REVIEWED_MILLISECONDS
BHP_PANEL_SUPERVISOR_DAY_BRIGHTNESS=100
BHP_PANEL_SUPERVISOR_NIGHT_BRIGHTNESS=10
BHP_PANEL_SUPERVISOR_GRACE_DAY_BRIGHTNESS=40
BHP_PANEL_SUPERVISOR_GRACE_NIGHT_BRIGHTNESS=5
# Safety invariant: this is required to be exactly zero.
BHP_PANEL_SUPERVISOR_OFF_BRIGHTNESS=0
# Also bounds signal-interruptible initial clock-readiness retries.
BHP_PANEL_SUPERVISOR_POLL_INTERVAL_MILLISECONDS=250

# Must stay disabled until the chosen suspend path repeatedly wakes on hardware.
# Implemented values are disabled, freeze, and mem. The board profile's value is
# @BHP_BOARD_SUSPEND_STATE@ (BHP_BOARD_SUSPEND_STATE).
BHP_PANEL_SUPERVISOR_SUSPEND_MODE=disabled
# Required only when suspend mode is freeze or mem.
# BHP_PANEL_SUPERVISOR_POWER_STATE_PATH=/sys/power/state
# Required only for mem, rejected otherwise: the confirmed mem_sleep variant
# (BHP_BOARD_MEM_SLEEP_STATE, FRDM-GATE-SUSPEND on the FRDM).
# BHP_PANEL_SUPERVISOR_MEM_SLEEP_PATH=/sys/power/mem_sleep
# BHP_PANEL_SUPERVISOR_MEM_SLEEP_STATE=@BHP_BOARD_MEM_SLEEP_STATE@
# Rate-limits resuspend after a successful suspend/resume; failed writes remain fatal.
# BHP_PANEL_SUPERVISOR_SUSPEND_RETRY_BACKOFF_MILLISECONDS=5000
# Every enabled suspend first verifies kernel-visible microphone capture closure.
# Open capture refuses the suspend unless this names the media broker's exact
# service UID (never 0 or the UI UID), which enables its bounded SIGTERM/SIGKILL
# termination path. Leave it unset until the broker is packaged.
# BHP_PANEL_SUPERVISOR_MEDIA_BROKER_UID=1103

# ADR 0005 optional touch observer: disabled unless ALL thirteen fields are set.
# These placeholders deliberately fail validation. FRDM-GATE-TOUCH must select
# actual identities, raw bounds, protocol, and limits before production enablement.
# No UI principal may read the raw device. See panel_supervisor/README.md.
# BHP_PANEL_SUPERVISOR_TOUCH_INPUT_PATH=/dev/input/REPLACE_ME
# BHP_PANEL_SUPERVISOR_TOUCH_INPUT_NAME=REPLACE_ME_WITH_EXACT_NAME
# BHP_PANEL_SUPERVISOR_TOUCH_PROTOCOL=REPLACE_ME_WITH_SINGLE_OR_TYPE_B
# BHP_PANEL_SUPERVISOR_TOUCH_X_MIN=REPLACE_ME
# BHP_PANEL_SUPERVISOR_TOUCH_X_MAX=REPLACE_ME
# BHP_PANEL_SUPERVISOR_TOUCH_Y_MIN=REPLACE_ME
# BHP_PANEL_SUPERVISOR_TOUCH_Y_MAX=REPLACE_ME
# BHP_PANEL_SUPERVISOR_TOUCH_CONTACT_KEY=REPLACE_ME
# BHP_PANEL_SUPERVISOR_TOUCH_SLOTS=REPLACE_ME
# BHP_PANEL_SUPERVISOR_TOUCH_SOCKET=/run/beaglebone-house-panel/REPLACE_ME_TOUCH_SOCKET
# BHP_PANEL_SUPERVISOR_TOUCH_TTL_MILLISECONDS=REPLACE_ME
# BHP_PANEL_SUPERVISOR_TOUCH_MAX_CONTACT_MILLISECONDS=REPLACE_ME
# BHP_PANEL_SUPERVISOR_TOUCH_MAX_OBSERVATIONS=REPLACE_ME
