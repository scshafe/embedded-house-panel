# FRDM i.MX 8M Plus kernel requirements layered on imx_v8_defconfig
# (nxp-imx/linux-imx lf-6.12.49-2.2.0). Software prerequisites only: none of
# these options establishes that suspend, wake, display, touch, or audio works
# on the received board. See the FRDM-GATE-* rows in ADR 0008.
#
# Suspend-to-RAM and attributed wake (FRDM-GATE-SUSPEND, FRDM-GATE-PIR).
# PM_SLEEP, PM_SLEEP_DEBUG, ARM_PSCI_FW, and IMX_GPCV2 are not user-settable;
# they are listed so the effective-config check proves they resolved to y.
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_ARM_PSCI_FW=y
CONFIG_IMX_GPCV2=y
CONFIG_GPIO_MXC=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_EVDEV=y
# Display path and bridge-registered backlight (FRDM-GATE-DISPLAY,
# FRDM-GATE-BACKLIGHT), plus the explicit fbdev fallback.
CONFIG_DRM_WAVESHARE_BRIDGE=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_FBDEV_EMULATION=y
