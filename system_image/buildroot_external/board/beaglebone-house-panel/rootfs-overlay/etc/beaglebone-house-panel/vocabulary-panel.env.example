# Copy to vocabulary-panel.env, keep owned by root:vocabulary-panel, and use
# mode 0640. S80bhp-vocabulary-panel stays inert unless this is exactly 1.
BHP_VOCABULARY_PANEL_ENABLED=0

# Replace only after inspecting Lexinet's real API and authentication contract.
BHP_VOCABULARY_PANEL_LEXINET_BASE_URL=https://lexinet-placeholder.example.ts.net
BHP_VOCABULARY_PANEL_NEXT_CARD_PATH=/api/v1/vocabulary-review-cards/next
BHP_VOCABULARY_PANEL_REVIEW_PATH=/api/v1/vocabulary-review-results

# Store the credential outside the immutable image, owned by vocabulary-panel,
# mode 0400. Never put the credential value in this environment file.
BHP_VOCABULARY_PANEL_CREDENTIAL_FILE=/var/lib/beaglebone-house-panel/lexinet.credential
BHP_VOCABULARY_PANEL_MODE_SOCKET=/run/beaglebone-house-panel/panel-mode.sock
BHP_VOCABULARY_PANEL_REQUEST_TIMEOUT_MS=5000
BHP_VOCABULARY_PANEL_OFFLINE_CACHE_LIMIT=32
