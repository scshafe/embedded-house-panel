# Copy to vocabulary-panel.env, keep owned by root:vocabulary-panel, and use
# mode 0640. S80bhp-vocabulary-panel stays inert unless this is exactly 1.
BHP_VOCABULARY_PANEL_ENABLED=0

# study.v1 client configuration (docs/interfaces/lexinet-contract.md). Lexinet's
# native-TLS Tailnet study listener: MagicDNS name, port 443, HTTPS only.
BHP_VOCABULARY_PANEL_LEXINET_BASE_URL=https://lexinet-placeholder.example.ts.net
BHP_VOCABULARY_PANEL_STUDY_PROFILE_REF=replace.with.profile
BHP_VOCABULARY_PANEL_STUDY_TOPIC_REFS=replace-with-topic-slug

# ADR 0010: tailnet_node. The panel stores no study credential; keep the
# credential path empty. Never put a credential value, auth key or Tailnet
# state in this file or in the image.
BHP_VOCABULARY_PANEL_STUDY_AUTH_MODE=tailnet_node
BHP_VOCABULARY_PANEL_CREDENTIAL_FILE=

BHP_VOCABULARY_PANEL_CONNECT_TIMEOUT_MS=1000
BHP_VOCABULARY_PANEL_REQUEST_TIMEOUT_MS=3000
BHP_VOCABULARY_PANEL_MAXIMUM_RESPONSE_BYTES=1048576
BHP_VOCABULARY_PANEL_MAXIMUM_SNAPSHOT_AGE_SECONDS=604800
