config BR2_PACKAGE_BHP_PANEL_UI
	bool "bhp-panel-ui"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_9 # complete C++17 support
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_OPENSSL_FORCE_LIBOPENSSL
	help
	  Build the neutral BeagleBone House Panel shell core and its sole
	  installed fail-dark lifecycle service executable.

	  This package is host-neutral software evidence only. No physical
	  display-commit or raw-input backend is enabled, so target service
	  activation and presentation readiness remain unavailable.

comment "bhp-panel-ui needs C++, gcc >= 9"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_GCC_AT_LEAST_9
