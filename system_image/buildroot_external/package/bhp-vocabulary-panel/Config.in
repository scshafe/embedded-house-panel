config BR2_PACKAGE_BHP_VOCABULARY_PANEL
	bool "bhp-vocabulary-panel"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_9 # complete C++17 support
	depends on BR2_TOOLCHAIN_HAS_THREADS # lvgl/libdrm
	select BR2_PACKAGE_LVGL
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_LIBCURL_FORCE_TLS
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_OPENSSL_FORCE_LIBOPENSSL
	select BR2_PACKAGE_CA_CERTIFICATES
	select BR2_PACKAGE_JSON_FOR_MODERN_CPP
	help
	  Build the BeagleBone House Panel flash-card state machine,
	  fixture terminal, LVGL renderer library, and provisional
	  HTTPS Lexinet adapter.

	  The adapter is compiled with TLS certificate verification,
	  but the real Lexinet HTTP contract and target display/touch
	  controller remain unverified. The target service is disabled
	  until those boundaries are implemented and tested.

comment "bhp-vocabulary-panel needs C++, gcc >= 9, threads"
	depends on !BR2_INSTALL_LIBSTDCPP || \
		!BR2_TOOLCHAIN_GCC_AT_LEAST_9 || !BR2_TOOLCHAIN_HAS_THREADS
