{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beaglebone-house-panel.local/schemas/frdm_gate_evidence.schema.json",
  "title": "FRDM gate evidence record",
  "$comment": "@canonical frdm_gate_evidence_schema -- written only by hardware_tests/frdm/lib/frdm_evidence.sh. `candidates` are values a reviewer may copy into config/boards/<board>.env; nothing closes a gate automatically.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "gate", "script", "trace_id", "board_profile_id", "board_profile_path",
    "started_at_utc", "finished_at_utc", "kernel_release", "image_project_commit",
    "fixture_root", "result", "counts", "gate_closed", "hardware_evidence",
    "checks", "observations", "candidates", "actions", "artifacts"
  ],
  "properties": {
    "schema": {"const": "bhp.frdm_gate_evidence.v1"},
    "gate": {"type": "string", "pattern": "^FRDM-GATE-[A-Z0-9-]+$"},
    "script": {"type": "string", "pattern": "^frdm_[a-z0-9_]+$"},
    "trace_id": {"type": "string", "minLength": 1},
    "board_profile_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "board_profile_path": {"type": "string", "minLength": 1},
    "started_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "finished_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "kernel_release": {"type": "string"},
    "image_project_commit": {"type": "string"},
    "fixture_root": {"type": "boolean"},
    "result": {"enum": ["complete", "incomplete", "mismatch"]},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "fail", "unobserved"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "unobserved": {"type": "integer", "minimum": 0}
      }
    },
    "gate_closed": {"const": false},
    "hardware_evidence": {"enum": ["captured_unreviewed", "fixture_not_evidence"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "expected", "observed", "status", "basis"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "expected": {"type": "string"},
          "observed": {"type": "string"},
          "status": {"enum": ["pass", "fail", "unobserved", "not_applicable"]},
          "basis": {"type": "string"}
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value"],
        "properties": {"key": {"type": "string", "minLength": 1}, "value": {"type": "string"}}
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_key", "candidate_value", "basis", "current_profile_value"],
        "properties": {
          "profile_key": {"type": "string", "pattern": "^BHP_BOARD_[A-Z0-9_]+$"},
          "candidate_value": {"type": "string", "pattern": "^[A-Za-z0-9_./:,@+=*%-]*$"},
          "basis": {"type": "string"},
          "current_profile_value": {"type": "string"}
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "detail", "at_utc"],
        "properties": {
          "action": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "detail": {"type": "string"},
          "at_utc": {"type": "string"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "command_exit_status"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "command_exit_status": {"type": "integer"}
        }
      }
    }
  }
}
