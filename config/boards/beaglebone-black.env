# @canonical board_profile.beaglebone-black -- lost BeagleBone Black + 4D LCD cape (history).
#
# Status history: ADR 0008 replaced this assembly after the board was lost. The
# build keys stay valid so the deprecated BBB defconfigs and CMake preset keep
# evaluating; no runtime value was ever measured on this assembly. The legacy
# P9_21 / GPIO0_3 PIR clue lives in presence_sensor/experiments/ as history.

BHP_BOARD_PROFILE_SCHEMA=1
BHP_BOARD_ID=beaglebone-black
BHP_BOARD_STATUS=history
BHP_BOARD_DECISION=ADR-0003
BHP_BOARD_DT_COMPATIBLE=ti,am335x-bone-black

BHP_BOARD_TARGET_ARCH=arm
BHP_BOARD_TARGET_CPU=cortex-a8
BHP_BOARD_TARGET_ELF_MACHINE=40
BHP_BOARD_BUILDROOT_CROSS_PREFIX=arm-buildroot-linux-gnueabihf
BHP_BOARD_CMAKE_SYSTEM_PROCESSOR=arm
BHP_BOARD_CMAKE_PRESET=buildroot-armv7-release
BHP_BOARD_KERNEL_ARCH=arm

BHP_BOARD_BUILDROOT_DEFCONFIG_PRODUCTION=beaglebone_house_panel_defconfig
BHP_BOARD_BUILDROOT_DEFCONFIG_BRINGUP=beaglebone_house_panel_bringup_defconfig
BHP_BOARD_BUILDROOT_BOARD_DIRECTORY=board/beaglebone-house-panel
BHP_BOARD_SUSPEND_KCONFIG_FRAGMENT=board/beaglebone-house-panel/linux-suspend-prerequisites.config
BHP_BOARD_SUSPEND_KCONFIG_SYMBOLS=CONFIG_AMX3_PM,CONFIG_WKUP_M3_IPC,CONFIG_WKUP_M3_RPROC,CONFIG_TI_EMIF_SRAM
BHP_BOARD_SUSPEND_KCONFIG_FRAGMENT_VALUE=m
BHP_BOARD_LINUX_SOURCE=kernel.org:linux@6.18.21
BHP_BOARD_UBOOT_SOURCE=denx:u-boot@2026.04
BHP_BOARD_UBOOT_DEFCONFIG=am335x_evm
BHP_BOARD_BOOT_DTB=am335x-boneblack.dtb
BHP_BOARD_IMAGE_ARTIFACTS=sdcard.img,boot.vfat,rootfs.ext4,zImage,am335x-boneblack.dtb,MLO,u-boot.img
BHP_BOARD_PRESENCE_OVERLAYS=beagle-house-custom-pir,beagle-house-gpio-keys-wake-baseline
BHP_BOARD_BRINGUP_DHCP_INTERFACE=eth0

BHP_BOARD_DISPLAY_BACKEND=UNMEASURED:BBB-HISTORY
BHP_BOARD_BACKLIGHT_SYSFS_DIR=UNMEASURED:BBB-HISTORY
BHP_BOARD_PIR_GPIO_CONTROLLER=UNMEASURED:BBB-HISTORY
BHP_BOARD_PIR_GPIO_LINE=UNMEASURED:BBB-HISTORY
# Node names from the BBB overlays. Their EVIOCGNAMEs contain spaces, which the
# profile grammar cannot hold, so S31 and classify-touch-input keep them as
# literal history.
BHP_BOARD_PIR_DT_NODE=gpio-keys-presence-baseline
BHP_BOARD_PIR_CUSTOM_DT_NODE=presence-sensor-custom-pir
BHP_BOARD_SUSPEND_STATE=mem
BHP_BOARD_MEM_SLEEP_STATE=UNMEASURED:BBB-HISTORY
