{
  "$comment": "@canonical board_profile_schema -- enforced by scripts/verification/verify_board_profiles.py; the shell loader enforces only the line grammar.",
  "schema_version": 1,
  "file_pattern": "config/boards/<board-id>.env",
  "board_id_pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
  "line_grammar": {
    "comment": "^#.*$",
    "blank": "^$",
    "assignment": "^(BHP_BOARD_[A-Z0-9_]+)=([A-Za-z0-9_./:,@+=*%-]*)$"
  },
  "placeholders": {
    "unmeasured": "^UNMEASURED:[A-Z0-9]+(-[A-Z0-9]+)+$",
    "human_decision": "^HUMAN_DECISION_REQUIRED:[A-Z0-9]+(-[A-Z0-9]+)+$"
  },
  "value_encoding": {
    "percent_escape": "^%[0-9A-F]{2}$",
    "rule": "A '%' in a value always starts an RFC 3986 %XX escape with uppercase hex. Only BHP_BOARD_TOUCH_INPUT_NAME and BHP_BOARD_TOUCH_INPUT_PHYS may need one (kernel input names can contain spaces, e.g. %20); consumers decode before comparing with sysfs."
  },
  "active_gate_source": {
    "path": "docs/decisions/0008-adopt-frdm-imx8mplus-and-waveshare-7-inch-dsi-development-platform.md",
    "row_pattern": "^\\| `(FRDM-GATE-[A-Z0-9-]+)` \\|",
    "rule": "Every UNMEASURED:FRDM-GATE-* value in an active profile must name a gate row in the source ADR."
  },
  "reserved_keys": [
    "BHP_BOARD_SSH_TARGET",
    "BHP_BOARD_UPLOAD_DIR"
  ],
  "reserved_keys_reason": "Deployment variables share the BHP_BOARD_ prefix; a profile must never shadow them.",
  "status_values": [
    "active",
    "history",
    "simulation"
  ],
  "exactly_one_active": true,
  "required_keys": {
    "BHP_BOARD_PROFILE_SCHEMA": "^1$",
    "BHP_BOARD_ID": "^[a-z0-9]+(-[a-z0-9]+)*$",
    "BHP_BOARD_STATUS": "^(active|history)$",
    "BHP_BOARD_DECISION": "^ADR-[0-9]{4}$",
    "BHP_BOARD_DT_COMPATIBLE": "^[a-z0-9-]+,[a-z0-9.-]+$",
    "BHP_BOARD_TARGET_ARCH": "^(aarch64|arm)$",
    "BHP_BOARD_TARGET_CPU": "^cortex-a[0-9]+$",
    "BHP_BOARD_TARGET_ELF_MACHINE": "^(183|40)$",
    "BHP_BOARD_BUILDROOT_CROSS_PREFIX": "^[a-z0-9_]+-buildroot-linux-gnu[a-z]*$",
    "BHP_BOARD_CMAKE_SYSTEM_PROCESSOR": "^(aarch64|arm)$",
    "BHP_BOARD_CMAKE_PRESET": "^buildroot-[a-z0-9]+-release$",
    "BHP_BOARD_KERNEL_ARCH": "^(arm64|arm)$",
    "BHP_BOARD_BUILDROOT_DEFCONFIG_PRODUCTION": "^[a-z0-9_]+_defconfig$",
    "BHP_BOARD_BUILDROOT_DEFCONFIG_BRINGUP": "^[a-z0-9_]+_bringup_defconfig$",
    "BHP_BOARD_BUILDROOT_BOARD_DIRECTORY": "^board/[a-z0-9./-]+$",
    "BHP_BOARD_SUSPEND_KCONFIG_FRAGMENT": "^board/[a-z0-9./-]+\\.config$",
    "BHP_BOARD_SUSPEND_KCONFIG_SYMBOLS": "^CONFIG_[A-Z0-9_]+(,CONFIG_[A-Z0-9_]+)*$",
    "BHP_BOARD_SUSPEND_KCONFIG_FRAGMENT_VALUE": "^(y|m)$",
    "BHP_BOARD_BOOT_DTB": "^[a-z0-9-]+\\.dtb$",
    "BHP_BOARD_IMAGE_ARTIFACTS": "^[A-Za-z0-9_.-]+(,[A-Za-z0-9_.-]+)*$",
    "BHP_BOARD_PRESENCE_OVERLAYS": "^[a-z0-9-]+(,[a-z0-9-]+)*$",
    "BHP_BOARD_BRINGUP_DHCP_INTERFACE": "^[a-z0-9]+$",
    "BHP_BOARD_SUSPEND_STATE": "^(mem|freeze)$",
    "BHP_BOARD_MEM_SLEEP_STATE": "^(deep|s2idle|shallow)$",
    "BHP_BOARD_DISPLAY_BACKEND": "^(drm|fbdev)$",
    "BHP_BOARD_BACKLIGHT_SYSFS_DIR": "^/sys/class/backlight/[A-Za-z0-9_.:-]+$",
    "BHP_BOARD_PIR_GPIO_CONTROLLER": "^gpio[1-9]$",
    "BHP_BOARD_PIR_GPIO_LINE": "^([0-9]|[12][0-9]|3[01])$",
    "BHP_BOARD_PIR_DT_NODE": "^[a-z0-9-]+$",
    "BHP_BOARD_PIR_CUSTOM_DT_NODE": "^[a-z0-9-]+$"
  },
  "required_keys_when_active": {
    "BHP_BOARD_NXP_FIRMWARE_EULA": "^(accepted-adr-[0-9]{4}|not-required)$",
    "BHP_BOARD_CONSOLE_TTY": "^tty[A-Za-z0-9]+$",
    "BHP_BOARD_CONSOLE_BAUD": "^[0-9]+$",
    "BHP_BOARD_DEBUG_USB_CONNECTOR": "^J[0-9]+$",
    "BHP_BOARD_USB_DOWNLOAD_CONNECTOR": "^J[0-9]+$",
    "BHP_BOARD_BOOT_SWITCH": "^SW[0-9]+$",
    "BHP_BOARD_BOOT_SWITCH_EMMC": "^[01]{4}$",
    "BHP_BOARD_BOOT_SWITCH_MICROSD": "^[01]{4}$",
    "BHP_BOARD_BOOT_SWITCH_USB_SERIAL_DOWNLOAD": "^[01]{4}$",
    "BHP_BOARD_LINUX_SOURCE": "^github:[a-z0-9-]+/[a-z0-9-]+@[A-Za-z0-9._-]+$",
    "BHP_BOARD_UBOOT_SOURCE": "^github:[a-z0-9-]+/[a-z0-9-]+@[A-Za-z0-9._-]+$",
    "BHP_BOARD_ATF_SOURCE": "^github:[a-z0-9-]+/[a-z0-9-]+@[A-Za-z0-9._-]+$",
    "BHP_BOARD_UBOOT_DEFCONFIG": "^[a-z0-9_]+$",
    "BHP_BOARD_KERNEL_BASE_DTB": "^[a-z0-9/-]+\\.dtb$",
    "BHP_BOARD_PROJECT_OVERLAY_TEMPLATE": "^[a-z0-9_./-]+\\.dtso\\.in$",
    "BHP_BOARD_PRESENCE_CUSTOM_OVERLAY_TEMPLATE": "^[a-z0-9_./-]+\\.dtso\\.in$",
    "BHP_BOARD_EXPECTED_SOC_ID": "^[A-Za-z0-9.]+$",
    "BHP_BOARD_EXPECTED_CPU_COUNT": "^[1-9][0-9]*$",
    "BHP_BOARD_EXPECTED_RAM_GIB": "^[0-9]+$",
    "BHP_BOARD_EXPECTED_EMMC_GB": "^[0-9]+$",
    "BHP_BOARD_EXPECTED_EMMC_MMC_HOST": "^[0-9a-f]+\\.mmc$",
    "BHP_BOARD_EXPECTED_WIFI_CHIP": "^[A-Z0-9]+$",
    "BHP_BOARD_EXPECTED_WIFI_SDIO_HOST": "^[0-9a-f]+\\.mmc$",
    "BHP_BOARD_POWER_INPUT_CONNECTOR": "^J[0-9]+$",
    "BHP_BOARD_POWER_INPUT_REQUIREMENT": "^[a-z0-9-]+$",
    "BHP_BOARD_POWER_BOUNDARY": "^(board_input|product_battery)$",
    "BHP_BOARD_DISPLAY_BACKEND_FALLBACK": "^(drm|fbdev)$",
    "BHP_BOARD_DISPLAY_RESOLUTION": "^[0-9]+x[0-9]+$",
    "BHP_BOARD_DRM_DEVICE": "^/dev/dri/card[0-9]+$",
    "BHP_BOARD_DRM_CONNECTOR_ID": "^[0-9]+$",
    "BHP_BOARD_FBDEV_DEVICE": "^/dev/fb[0-9]+$",
    "BHP_BOARD_BACKLIGHT_EXPECTED_NAME_GLOB": "^[A-Za-z0-9*_.:-]+$",
    "BHP_BOARD_BACKLIGHT_EXPECTED_MAX_BRIGHTNESS": "^[0-9]+$",
    "BHP_BOARD_BACKLIGHT_OFF_VALUE": "^[0-9]+$",
    "BHP_BOARD_TOUCH_EXPECTED_DRIVER": "^[a-z0-9_-]+$",
    "BHP_BOARD_TOUCH_EXPECTED_I2C_CONTROLLER": "^i2c[0-9]+$",
    "BHP_BOARD_TOUCH_EXPECTED_I2C_ADDRESS": "^0x[0-9a-f]{2}$",
    "BHP_BOARD_TOUCH_EXPECTED_MODE": "^(polled|interrupt)$",
    "BHP_BOARD_TOUCH_INPUT_NAME": "^([A-Za-z0-9_.:-]|%[0-9A-F]{2})+$",
    "BHP_BOARD_TOUCH_INPUT_PHYS": "^([A-Za-z0-9_./:-]|%[0-9A-F]{2})+$",
    "BHP_BOARD_TOUCH_INTERRUPT": "^(polled|gpio[1-9]:([0-9]|[12][0-9]|3[01]))$",
    "BHP_BOARD_PIR_HEADER_PIN": "^J[0-9]+-([1-9]|[1-3][0-9]|40)$",
    "BHP_BOARD_HEADER_IO_VOLTAGE_MV": "^(1800|3300)$",
    "BHP_BOARD_PIR_PAD_MUX": "^MX8MP_IOMUXC_[A-Z0-9_]+__GPIO[1-5]_IO[0-9]{2}$",
    "BHP_BOARD_PIR_ACTIVE_LEVEL": "^(high|low)$",
    "BHP_BOARD_PIR_PAD_OWNER_TO_DISABLE": "^(none|[a-z][a-z0-9_]*)$",
    "BHP_BOARD_PIR_PAD_CONTROL": "^0x[0-9a-f]+$",
    "BHP_BOARD_PIR_INPUT_NAME": "^[a-z0-9-]+$",
    "BHP_BOARD_PIR_WAKE_INTERRUPT_LABEL": "^[a-z0-9-]+$",
    "BHP_BOARD_PIR_CUSTOM_INPUT_NAME": "^[a-z0-9-]+$",
    "BHP_BOARD_WAKE_IRQ_PATH": "^/sys/power/pm_wakeup_irq$",
    "BHP_BOARD_WIFI_EXPECTED_DRIVER": "^[a-z0-9_-]+$",
    "BHP_BOARD_WIFI_INTERFACE": "^[a-z0-9]+$",
    "BHP_BOARD_AUDIO_EXPECTED_CARD_ID": "^[A-Za-z0-9]+$",
    "BHP_BOARD_AUDIO_EXPECTED_CODEC_I2C_ADDRESS": "^0x[0-9a-f]{2}$",
    "BHP_BOARD_AUDIO_MIC_SOURCE": "^[a-z0-9.-]+$",
    "BHP_BOARD_AUDIO_CAPTURE_DEVICE": "^hw:CARD=[A-Za-z0-9]+,DEV=[0-9]+$"
  },
  "placeholder_allowed_keys": [
    "BHP_BOARD_NXP_FIRMWARE_EULA",
    "BHP_BOARD_MEM_SLEEP_STATE",
    "BHP_BOARD_DISPLAY_BACKEND",
    "BHP_BOARD_DRM_DEVICE",
    "BHP_BOARD_DRM_CONNECTOR_ID",
    "BHP_BOARD_FBDEV_DEVICE",
    "BHP_BOARD_BACKLIGHT_SYSFS_DIR",
    "BHP_BOARD_BACKLIGHT_OFF_VALUE",
    "BHP_BOARD_TOUCH_INPUT_NAME",
    "BHP_BOARD_TOUCH_INPUT_PHYS",
    "BHP_BOARD_TOUCH_INTERRUPT",
    "BHP_BOARD_PIR_HEADER_PIN",
    "BHP_BOARD_HEADER_IO_VOLTAGE_MV",
    "BHP_BOARD_PIR_GPIO_CONTROLLER",
    "BHP_BOARD_PIR_GPIO_LINE",
    "BHP_BOARD_PIR_PAD_MUX",
    "BHP_BOARD_PIR_ACTIVE_LEVEL",
    "BHP_BOARD_PIR_PAD_OWNER_TO_DISABLE",
    "BHP_BOARD_WIFI_INTERFACE",
    "BHP_BOARD_AUDIO_CAPTURE_DEVICE"
  ],
  "project_file_references": [
    "BHP_BOARD_PROJECT_OVERLAY_TEMPLATE",
    "BHP_BOARD_PRESENCE_CUSTOM_OVERLAY_TEMPLATE"
  ],
  "file_references": {
    "BHP_BOARD_BUILDROOT_DEFCONFIG_PRODUCTION": "system_image/buildroot_external/configs/{value}",
    "BHP_BOARD_BUILDROOT_DEFCONFIG_BRINGUP": "system_image/buildroot_external/configs/{value}",
    "BHP_BOARD_BUILDROOT_BOARD_DIRECTORY": "system_image/buildroot_external/{value}",
    "BHP_BOARD_SUSPEND_KCONFIG_FRAGMENT": "system_image/buildroot_external/{value}"
  },
  "cmake_preset_reference": "BHP_BOARD_CMAKE_PRESET",
  "simulation_board_ids": [
    "qemu-aarch64-virt"
  ],
  "required_keys_when_simulation": {
    "BHP_BOARD_PROFILE_SCHEMA": "^1$",
    "BHP_BOARD_ID": "^qemu\\-aarch64\\-virt$",
    "BHP_BOARD_STATUS": "^simulation$",
    "BHP_BOARD_DECISION": "^ADR\\-0009$",
    "BHP_BOARD_SIMULATION_EVIDENCE": "^simulation_not_hardware_evidence$",
    "BHP_BOARD_TARGET_ARCH": "^aarch64$",
    "BHP_BOARD_TARGET_ELF_MACHINE": "^183$",
    "BHP_BOARD_CMAKE_SYSTEM_PROCESSOR": "^aarch64$",
    "BHP_BOARD_QEMU_MACHINE": "^virt$",
    "BHP_BOARD_QEMU_CPU": "^host$",
    "BHP_BOARD_DISPLAY_BACKEND": "^drm$",
    "BHP_BOARD_DISPLAY_RESOLUTION": "^1024x600$",
    "BHP_BOARD_BACKLIGHT_SYSFS_DIR": "^/sys/class/backlight/bhp\\-sim$",
    "BHP_BOARD_BACKLIGHT_OFF_VALUE": "^0$",
    "BHP_BOARD_PIR_INPUT_NAME": "^bhp\\-sim\\-pir$",
    "BHP_BOARD_TOUCH_INPUT_NAME": "^QEMU%20Virtio%20Tablet$",
    "BHP_BOARD_TOUCH_MULTITOUCH_INPUT_NAME": "^QEMU%20Virtio%20MultiTouch$",
    "BHP_BOARD_SUSPEND_STATE": "^disabled$",
    "BHP_BOARD_NXP_FIRMWARE_EULA": "^not\\-required$"
  }
}
