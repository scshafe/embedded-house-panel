# @canonical board_profile.frdm-imx8mp -- NXP FRDM i.MX 8M Plus + Waveshare 7inch DSI LCD (C).
#
# Grammar and placeholder rules: config/boards/README.md and
# config/boards/board-profile.schema.json. This file is read by POSIX sh
# (scripts/boards/board_profile.sh), by make (Buildroot packages), and by
# scripts/verification/verify_board_profiles.py. It is never executed.
#
# UNMEASURED:<gate> values have no default. Every consumer fails with
# BOARD_PROFILE.VALUE_UNMEASURED until on-board evidence for <gate> is recorded
# under hardware_tests/results/ and the value is replaced here in a reviewed
# commit. EXPECTED_* values are source-derived hints for evidence scripts only;
# they are never runtime configuration.

BHP_BOARD_PROFILE_SCHEMA=1
BHP_BOARD_ID=frdm-imx8mp
BHP_BOARD_STATUS=active
BHP_BOARD_DECISION=ADR-0008
BHP_BOARD_DT_COMPATIBLE=fsl,frdm-imx8mp

# Build target. Cortex-A53, AArch64 glibc (Bootlin stable external toolchain).
BHP_BOARD_TARGET_ARCH=aarch64
BHP_BOARD_TARGET_CPU=cortex-a53
BHP_BOARD_TARGET_ELF_MACHINE=183
BHP_BOARD_BUILDROOT_CROSS_PREFIX=aarch64-buildroot-linux-gnu
BHP_BOARD_CMAKE_SYSTEM_PROCESSOR=aarch64
BHP_BOARD_CMAKE_PRESET=buildroot-aarch64-release
BHP_BOARD_KERNEL_ARCH=arm64

# Buildroot external tree (paths relative to system_image/buildroot_external).
BHP_BOARD_BUILDROOT_DEFCONFIG_PRODUCTION=frdm_imx8mp_house_panel_defconfig
BHP_BOARD_BUILDROOT_DEFCONFIG_BRINGUP=frdm_imx8mp_house_panel_bringup_defconfig
BHP_BOARD_BUILDROOT_BOARD_DIRECTORY=board/beaglebone-house-panel/frdm-imx8mp
BHP_BOARD_SUSPEND_KCONFIG_FRAGMENT=board/beaglebone-house-panel/frdm-imx8mp/linux-frdm-imx8mp.config
BHP_BOARD_SUSPEND_KCONFIG_SYMBOLS=CONFIG_SUSPEND,CONFIG_PM_SLEEP,CONFIG_PM_SLEEP_DEBUG,CONFIG_ARM_PSCI_FW,CONFIG_IMX_GPCV2,CONFIG_GPIO_MXC,CONFIG_KEYBOARD_GPIO
BHP_BOARD_SUSPEND_KCONFIG_FRAGMENT_VALUE=y
BHP_BOARD_LINUX_SOURCE=github:nxp-imx/linux-imx@lf-6.12.49-2.2.0
BHP_BOARD_UBOOT_SOURCE=github:nxp-imx/uboot-imx@lf-6.12.49-2.2.0
BHP_BOARD_ATF_SOURCE=github:nxp-imx/imx-atf@lf-6.12.49-2.2.0
BHP_BOARD_UBOOT_DEFCONFIG=imx8mp_frdm
BHP_BOARD_KERNEL_BASE_DTB=freescale/imx8mp-frdm-waveshare-7inch-c-panel.dtb
BHP_BOARD_BOOT_DTB=imx8mp-frdm-bhp-panel.dtb
BHP_BOARD_IMAGE_ARTIFACTS=sdcard.img,imx8-boot-sd.bin,boot.vfat,rootfs.ext4,Image,imx8mp-frdm-bhp-panel.dtb
BHP_BOARD_PRESENCE_OVERLAYS=bhp-frdm-pir-custom
# Templates rendered from this profile (paths relative to the project root).
# The project overlay carries the primary gpio-keys PIR node and is merged into
# BHP_BOARD_BOOT_DTB; the custom-driver overlay is an inert secondary experiment.
BHP_BOARD_PROJECT_OVERLAY_TEMPLATE=system_image/buildroot_external/board/beaglebone-house-panel/frdm-imx8mp/dts/bhp-frdm-imx8mp-panel.dtso.in
BHP_BOARD_PRESENCE_CUSTOM_OVERLAY_TEMPLATE=presence_sensor/experiments/custom_pir_input_driver/frdm-imx8mp-custom-pir-overlay.dtso.in
# Human decision (not a measurement): NXP Software License Agreement for
# firmware-imx (LPDDR4 training) and the IW612 Wi-Fi/BT firmware.
BHP_BOARD_NXP_FIRMWARE_EULA=HUMAN_DECISION_REQUIRED:NXP-FIRMWARE-EULA

# Boot and console. UM12340 Table 8 (SW5) and Table 13 (J19, UART2, 115200).
BHP_BOARD_CONSOLE_TTY=ttymxc1
BHP_BOARD_CONSOLE_BAUD=115200
BHP_BOARD_DEBUG_USB_CONNECTOR=J19
BHP_BOARD_BOOT_SWITCH=SW5
BHP_BOARD_BOOT_SWITCH_EMMC=0010
BHP_BOARD_BOOT_SWITCH_MICROSD=0011
BHP_BOARD_BOOT_SWITCH_USB_SERIAL_DOWNLOAD=0001

# Identity expectations (FRDM-GATE-IDENTITY). A distributor listing describes a
# 2 GB / 16 GB / M.2 Wi-Fi variant; these reject it.
BHP_BOARD_EXPECTED_RAM_GIB=4
BHP_BOARD_EXPECTED_EMMC_GB=32
BHP_BOARD_EXPECTED_EMMC_MMC_HOST=30b60000.mmc
BHP_BOARD_EXPECTED_WIFI_CHIP=IW612
BHP_BOARD_EXPECTED_WIFI_SDIO_HOST=30b40000.mmc

# Power (FRDM-GATE-POWER). J2 USB-C PD, 12-20 V, at least 45 W (65 W preferred).
BHP_BOARD_POWER_INPUT_CONNECTOR=J2
BHP_BOARD_POWER_INPUT_REQUIREMENT=usb-c-pd-12v-20v-45w-minimum-65w-preferred
BHP_BOARD_POWER_BOUNDARY=board_input

# Display (FRDM-GATE-DISPLAY). DRM first; fbdev is the explicit, operator-chosen
# fallback, never an automatic runtime switch.
BHP_BOARD_DISPLAY_BACKEND=drm
BHP_BOARD_DISPLAY_BACKEND_FALLBACK=fbdev
BHP_BOARD_DISPLAY_RESOLUTION=1024x600
BHP_BOARD_DRM_DEVICE=UNMEASURED:FRDM-GATE-DISPLAY
BHP_BOARD_DRM_CONNECTOR_ID=UNMEASURED:FRDM-GATE-DISPLAY
BHP_BOARD_FBDEV_DEVICE=UNMEASURED:FRDM-GATE-DISPLAY

# Backlight (FRDM-GATE-BACKLIGHT). No device-tree node is needed: the NXP
# waveshare,dsi2dpi bridge driver (drivers/gpu/drm/bridge/waveshare-dsi.c,
# lf-6.12.49-2.2.0) registers a BACKLIGHT_RAW device named after its I2C client
# (<bus>-0045) with max_brightness 255. Source-derived, not evidence.
BHP_BOARD_BACKLIGHT_EXPECTED_NAME_GLOB=*-0045
BHP_BOARD_BACKLIGHT_EXPECTED_MAX_BRIGHTNESS=255
BHP_BOARD_BACKLIGHT_SYSFS_DIR=UNMEASURED:FRDM-GATE-BACKLIGHT
BHP_BOARD_BACKLIGHT_OFF_VALUE=UNMEASURED:FRDM-GATE-BACKLIGHT

# Touch (FRDM-GATE-TOUCH). Goodix GT911 on i2c3 at 0x14 per the NXP overlay,
# which defines no interrupt: goodix.c then polls every 17 ms.
BHP_BOARD_TOUCH_EXPECTED_DRIVER=goodix
BHP_BOARD_TOUCH_EXPECTED_I2C_CONTROLLER=i2c3
BHP_BOARD_TOUCH_EXPECTED_I2C_ADDRESS=0x14
BHP_BOARD_TOUCH_EXPECTED_MODE=polled
BHP_BOARD_TOUCH_INPUT_NAME=UNMEASURED:FRDM-GATE-TOUCH
BHP_BOARD_TOUCH_INPUT_PHYS=UNMEASURED:FRDM-GATE-TOUCH
BHP_BOARD_TOUCH_INTERRUPT=UNMEASURED:FRDM-GATE-TOUCH

# PIR (FRDM-GATE-PIR). Must be a native SoC GPIO (gpio1..gpio5), never the
# PCAL6416A expanders (pca6416_a/pca6416_b), so it can wake suspend-to-RAM.
# The project overlay refuses to build until every UNMEASURED value is set.
BHP_BOARD_PIR_HEADER_PIN=UNMEASURED:FRDM-GATE-PIR
BHP_BOARD_HEADER_IO_VOLTAGE_MV=UNMEASURED:FRDM-GATE-PIR
BHP_BOARD_PIR_GPIO_CONTROLLER=UNMEASURED:FRDM-GATE-PIR
BHP_BOARD_PIR_GPIO_LINE=UNMEASURED:FRDM-GATE-PIR
BHP_BOARD_PIR_PAD_MUX=UNMEASURED:FRDM-GATE-PIR
BHP_BOARD_PIR_ACTIVE_LEVEL=UNMEASURED:FRDM-GATE-PIR
# DT label of a base-tree node that already claims the chosen pad (for example
# pwm3), which the overlay then disables, or none. From the J18 inventory.
BHP_BOARD_PIR_PAD_OWNER_TO_DISABLE=UNMEASURED:FRDM-GATE-PIR
# Design value, not a measurement: pull-down (PE, PUE=0) with Schmitt hysteresis,
# mirroring the BBB PIN_INPUT_PULLDOWN the PIR was verified with.
BHP_BOARD_PIR_PAD_CONTROL=0x180
# Names this project assigns (design values): the root-level device-tree node
# and EVIOCGNAME of the primary gpio-keys path and of the custom-driver path.
BHP_BOARD_PIR_DT_NODE=bhp-presence-pir
BHP_BOARD_PIR_INPUT_NAME=bhp-frdm-pir-gpio-keys
BHP_BOARD_PIR_CUSTOM_DT_NODE=presence-sensor-custom-pir
BHP_BOARD_PIR_CUSTOM_INPUT_NAME=bhp-frdm-pir-custom

# Suspend (FRDM-GATE-SUSPEND). The supervisor writes BHP_BOARD_SUSPEND_STATE to
# /sys/power/state only after selecting and confirming the mem_sleep variant.
BHP_BOARD_SUSPEND_STATE=mem
BHP_BOARD_MEM_SLEEP_STATE=UNMEASURED:FRDM-GATE-SUSPEND
BHP_BOARD_WAKE_IRQ_PATH=/sys/power/pm_wakeup_irq

# Network (FRDM-GATE-WIFI). The bring-up image uses DHCP on the first Ethernet
# port; which RJ45 jack is eth0 (EQOS or FEC) is not yet observed.
BHP_BOARD_BRINGUP_DHCP_INTERFACE=eth0
BHP_BOARD_WIFI_EXPECTED_DRIVER=moal
BHP_BOARD_WIFI_INTERFACE=UNMEASURED:FRDM-GATE-WIFI

# Audio (FRDM-GATE-AUDIO). WM8962 on i2c3 at 0x1a; CTIA headset mic through
# MICBIAS into IN3R/IN1R per the imx8mp-frdm.dts audio-routing.
BHP_BOARD_AUDIO_EXPECTED_CARD_ID=wm8962audio
BHP_BOARD_AUDIO_EXPECTED_CODEC_I2C_ADDRESS=0x1a
BHP_BOARD_AUDIO_MIC_SOURCE=ctia-headset-3.5mm
BHP_BOARD_AUDIO_CAPTURE_DEVICE=UNMEASURED:FRDM-GATE-AUDIO
