# Optional absolute Lexinet Git checkout used only by host-side cross-repository
# checks. Unset, they fetch the pinned commit (the repository_base_revision in
# vocabulary_panel/tests/fixtures/study_v1/contract-provenance.json) from GitHub
# into .build/lexinet/source/. No script may infer a sibling checkout or use this
# as a target runtime setting.
BHP_LEXINET_SOURCE_DIR=/absolute/path/to/lexinet

# Board profile id from config/boards/. Unset selects the single active profile
# (frdm-imx8mp, ADR 0008); beaglebone-black is deprecated history.
BHP_BOARD=frdm-imx8mp

# Absolute checkout of Buildroot 2026.05.1. Never point this at the project root.
BHP_BUILDROOT_DIR=/absolute/path/to/buildroot-2026.05.1

# Absolute Buildroot output directory; generated and safe to recreate.
BHP_BUILDROOT_OUTPUT_DIR=/absolute/path/to/beaglebone-house-panel-buildroot-output

# Buildroot SDK output/host directory used for manual cross-compilation.
BHP_BUILDROOT_HOST_DIR=/absolute/path/to/beaglebone-house-panel-buildroot-output/host

# Optional: compiler tuple under BHP_BUILDROOT_HOST_DIR/bin. When set it must
# equal BHP_BOARD_BUILDROOT_CROSS_PREFIX in the board profile.
BHP_BUILDROOT_CROSS_PREFIX=aarch64-buildroot-linux-gnu

# SSH destination. The FRDM bring-up image allows only root with the one
# caller-supplied Ed25519 key. Prefer a tailnet DNS name after provisioning.
BHP_BOARD_SSH_TARGET=root@frdm-imx8mp-placeholder

# Hardware gate (`make verify-board`, dev.toml [hardware] verify): the serial
# console on the development host (a /dev/serial/by-id/ path; checked for
# presence and permission, never opened) and the ARRIVAL-05 factory backup the
# eMMC boot regions are compared with. Both optional; unset is "unobserved".
BHP_BOARD_CONSOLE=/dev/serial/by-id/usb-placeholder-if00
BHP_FRDM_FACTORY_BACKUP_DIR=/absolute/path/to/factory-backup

# Staging only: uploads never install directly into /usr or /etc. The bring-up
# image has no unprivileged login, so stage below /tmp (cleared at reboot).
BHP_BOARD_UPLOAD_DIR=/tmp/beaglebone-house-panel-staging
