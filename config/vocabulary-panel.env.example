# study.v1 client configuration for the vocabulary surface (vocabulary_panel
# domain, hosted beneath bhp-panel-ui). Lexinet remains authoritative; the wire
# contract is Lexinet's contracts/study.v1 (docs/interfaces/lexinet-contract.md).
# Never put a credential value, auth key or Tailnet state in this file.

# Lexinet's native-TLS Tailnet study listener: MagicDNS name, port 443, HTTPS only.
BHP_VOCABULARY_PANEL_LEXINET_BASE_URL=https://lexinet-placeholder.example.ts.net

# Learner profile and comma-separated Lexinet topic slugs for create-or-resume.
BHP_VOCABULARY_PANEL_STUDY_PROFILE_REF=replace.with.profile
BHP_VOCABULARY_PANEL_STUDY_TOPIC_REFS=replace-with-topic-slug

# ADR 0010: tailnet_node. Lexinet authorizes the panel's tagged Tailnet identity;
# the panel stores no study credential, so the credential path stays empty.
BHP_VOCABULARY_PANEL_STUDY_AUTH_MODE=tailnet_node
BHP_VOCABULARY_PANEL_CREDENTIAL_FILE=

# Transport and freshness bounds for the study worker.
BHP_VOCABULARY_PANEL_CONNECT_TIMEOUT_MS=1000
BHP_VOCABULARY_PANEL_REQUEST_TIMEOUT_MS=3000
BHP_VOCABULARY_PANEL_MAXIMUM_RESPONSE_BYTES=1048576
BHP_VOCABULARY_PANEL_MAXIMUM_SNAPSHOT_AGE_SECONDS=604800
