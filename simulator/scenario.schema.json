{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "House panel simulation scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "surface": {
      "enum": [
        "home",
        "study",
        "agenda",
        "voice_lab"
      ]
    },
    "lifecycle": {
      "enum": [
        "day",
        "grace",
        "night",
        "blank",
        "clock_untrusted"
      ]
    },
    "study_state": {
      "enum": [
        "front",
        "back",
        "loading",
        "empty",
        "offline",
        "stale",
        "error",
        "queued",
        "saved",
        "rejected",
        "provisional",
        "refill",
        "resume",
        "tracking_paused",
        "complete"
      ]
    },
    "agenda_state": {
      "enum": [
        "today",
        "stale",
        "expired",
        "composer",
        "recording",
        "text_preview",
        "confirmation",
        "delivery_unknown",
        "unavailable"
      ]
    },
    "presentation_failure": {
      "type": "boolean"
    },
    "night_red_rgb888": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16777215
    },
    "fixture_clock": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "weather": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "description": "Explicit fixture weather only. Available and stale observations require both temperatures and high_celsius >= low_celsius; the scenario reader enforces the cross-property ordering.",
      "properties": {
        "state": {
          "enum": [
            "available",
            "unavailable",
            "stale"
          ]
        },
        "high_celsius": {
          "type": "integer",
          "minimum": -80,
          "maximum": 60
        },
        "low_celsius": {
          "type": "integer",
          "minimum": -80,
          "maximum": 60
        },
        "unit": {
          "enum": [
            "F",
            "C"
          ],
          "default": "F"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "available",
                  "stale"
                ]
              }
            }
          },
          "then": {
            "required": [
              "high_celsius",
              "low_celsius"
            ]
          }
        }
      ]
    },
    "clock_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previous",
        "elapsed_ms"
      ],
      "description": "Frozen preview reel frame. Runtime motion uses explicit monotonic sampling.",
      "properties": {
        "previous": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 400
        }
      }
    },
    "voice_lab_state": {
      "enum": [
        "signed_out",
        "ready",
        "recording",
        "review",
        "complete",
        "unavailable"
      ]
    }
  }
}
