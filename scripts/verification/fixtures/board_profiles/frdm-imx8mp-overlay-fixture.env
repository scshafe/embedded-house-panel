# TEST FIXTURE - NOT HARDWARE EVIDENCE. These values only exercise the FRDM
# overlay templates' syntax and substitution; they were chosen from pads the
# NXP base tree leaves unclaimed, not from any J18 measurement. Never copy
# them into config/boards/frdm-imx8mp.env.
BHP_BOARD_PROFILE_SCHEMA=1
BHP_BOARD_ID=frdm-imx8mp-overlay-fixture
BHP_BOARD_STATUS=history
BHP_BOARD_PIR_GPIO_CONTROLLER=gpio4
BHP_BOARD_PIR_GPIO_LINE=3
BHP_BOARD_PIR_PAD_MUX=MX8MP_IOMUXC_SAI1_RXD1__GPIO4_IO03
BHP_BOARD_PIR_PAD_CONTROL=0x180
BHP_BOARD_PIR_ACTIVE_LEVEL=high
BHP_BOARD_PIR_PAD_OWNER_TO_DISABLE=none
BHP_BOARD_PIR_INPUT_NAME=bhp-frdm-pir-gpio-keys
BHP_BOARD_PIR_CUSTOM_INPUT_NAME=bhp-frdm-pir-custom
