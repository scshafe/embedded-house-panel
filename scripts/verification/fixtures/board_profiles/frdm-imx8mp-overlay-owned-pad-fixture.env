# TEST FIXTURE - NOT HARDWARE EVIDENCE. Exercises the pad-owner path: the NXP
# base tree muxes GPIO1_IO10 to &pwm3, so the rendered overlay must disable
# &pwm3. Never copy these values into config/boards/frdm-imx8mp.env.
BHP_BOARD_PROFILE_SCHEMA=1
BHP_BOARD_ID=frdm-imx8mp-overlay-owned-pad-fixture
BHP_BOARD_STATUS=history
BHP_BOARD_PIR_GPIO_CONTROLLER=gpio1
BHP_BOARD_PIR_GPIO_LINE=10
BHP_BOARD_PIR_PAD_MUX=MX8MP_IOMUXC_GPIO1_IO10__GPIO1_IO10
BHP_BOARD_PIR_PAD_CONTROL=0x180
BHP_BOARD_PIR_ACTIVE_LEVEL=low
BHP_BOARD_PIR_PAD_OWNER_TO_DISABLE=pwm3
BHP_BOARD_PIR_INPUT_NAME=bhp-frdm-pir-gpio-keys
BHP_BOARD_PIR_CUSTOM_INPUT_NAME=bhp-frdm-pir-custom
